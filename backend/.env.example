# ==============================================================================
# SIH26117 — Sovereign On-Premise Agentic AI Workbench Configuration
# Copy this file to .env before starting the backend
# ==============================================================================

# Application Identity
APP_NAME="SIH26117 Sovereign AI Workbench"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Sovereignty & Air-Gap Enforcement Policy
# When True, all external outbound networking attempts are flagged and blocked
AIR_GAPPED_MODE=True
ALLOW_EXTERNAL_CONNECTIONS=False

# Hardware & Execution Profile
# Options: 'dev' (laptop/edge), 'target' (24-48GB workstation), 'cpu' (fallback)
HARDWARE_TIER=dev
GPU_BACKEND=cuda
VRAM_BUDGET_GB=8.0

# Local Inference Provider (strictly local backends)
# Options: 'ollama', 'llamacpp', 'vllm', 'mock'
INFERENCE_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLAMACPP_BASE_URL=http://127.0.0.1:8080
VLLM_BASE_URL=http://127.0.0.1:8000
MODEL_TIMEOUT_SECONDS=120

# Portable Relative Storage & Configuration Paths
# If relative, resolved automatically relative to PROJECT_ROOT
DATA_DIR=data
OUTPUT_DIR=outputs
LOG_DIR=logs
CONFIG_DIR=models/configs
MODEL_CONFIG_PATH=models/configs/model_tiers.yaml

# Logging Level
LOG_LEVEL=INFO

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
